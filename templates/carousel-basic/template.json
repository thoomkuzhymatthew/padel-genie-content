{
  "name": "carousel-basic",
  "purpose": "A hook, three to five single-idea content slides, and a closing hold-back slide.",
  "format": "carousel",
  "width": 1080,
  "height": 1350,
  "slides": {
    "min": 5,
    "max": 7
  },
  "fields": [
    {
      "name": "wordmark",
      "type": "string",
      "required": true,
      "max_characters": 24,
      "max_items": null,
      "min_items": null
    },
    {
      "name": "source_line",
      "type": "string",
      "required": true,
      "max_characters": 80,
      "max_items": null,
      "min_items": null
    },
    {
      "name": "hook",
      "type": "string",
      "required": true,
      "max_characters": 90,
      "max_items": null,
      "min_items": null
    },
    {
      "name": "content_slides",
      "type": "array",
      "required": true,
      "max_characters": null,
      "max_items": 5,
      "min_items": 3
    },
    {
      "name": "content_slides[].headline",
      "type": "string",
      "required": true,
      "max_characters": 70,
      "max_items": null,
      "min_items": null
    },
    {
      "name": "content_slides[].body",
      "type": "string",
      "required": true,
      "max_characters": 180,
      "max_items": null,
      "min_items": null
    },
    {
      "name": "content_slides[].hero",
      "type": "string",
      "required": false,
      "max_characters": 18,
      "max_items": null,
      "min_items": null
    },
    {
      "name": "closing_headline",
      "type": "string",
      "required": true,
      "max_characters": 70,
      "max_items": null,
      "min_items": null
    },
    {
      "name": "hold_back",
      "type": "string",
      "required": true,
      "max_characters": 130,
      "max_items": null,
      "min_items": null
    },
    {
      "name": "hook_hero",
      "type": "string",
      "required": true,
      "max_characters": 18,
      "min_items": null,
      "max_items": null
    },
    {
      "name": "hook_body",
      "type": "string",
      "required": true,
      "max_characters": 120,
      "min_items": null,
      "max_items": null
    },
    {
      "name": "hook_note",
      "type": "string",
      "required": true,
      "max_characters": 120,
      "min_items": null,
      "max_items": null
    },
    {
      "name": "content_slides[].note",
      "type": "string",
      "required": true,
      "max_characters": 120,
      "min_items": null,
      "max_items": null
    },
    {
      "name": "closing_hero",
      "type": "string",
      "required": true,
      "max_characters": 18,
      "min_items": null,
      "max_items": null
    },
    {
      "name": "closing_body",
      "type": "string",
      "required": true,
      "max_characters": 120,
      "min_items": null,
      "max_items": null
    }
  ]
}

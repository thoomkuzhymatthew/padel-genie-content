{
  "name": "padel-genie-content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "pipeline": "tsx pipeline/cli.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "ideate": "tsx pipeline/ideate.ts",
    "render": "tsx pipeline/render.ts",
    "write": "tsx pipeline/write.ts",
    "render:examples": "tsx pipeline/render-batch.ts",
    "db:migrate": "tsx pipeline/db/cli.ts migrate",
    "queue": "tsx pipeline/queue.ts",
    "dev": "vite --config vite.config.ts --host 127.0.0.1",
    "render:confirm": "tsx pipeline/render-confirm.ts",
    "verify:data": "tsx pipeline/verify-data.ts",
    "verify:browser": "tsx pipeline/verify-browser.ts",
    "learn": "tsx pipeline/learn.ts",
    "replay": "tsx pipeline/replay.ts",
    "triage": "tsx pipeline/triage.ts",
    "notify:retry": "tsx pipeline/notify-retry.ts",
    "verify:learning": "tsx pipeline/verify-learning.ts",
    "verify:learning-data": "tsx pipeline/verify-learning-data.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/vite": "^4.3.5",
    "cheerio": "^1.1.2",
    "csv-parse": "^7.0.3",
    "dotenv": "^17.2.3",
    "openai": "^6.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.3.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "playwright": "^1.65.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2",
    "vitest": "^4.0.8"
  }
}
